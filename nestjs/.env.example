# Local TypeScript migrations use source, even when dist exists.
NODE_ENV=local
ENV_NAME=development
USER_NAME=Developer
SAMPLE_NAME=boilerplate

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=boilerplate
DB_NAME_TEST=boilerplate_test
DB_SLOW_LIMIT=500
TEST_MAX_WORKERS=3

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EXCHANGE_NAME=boilerplate-events
RABBITMQ_MODE=false

JWT_ISSUER=boilerplate-issuer
JWT_SECRET=replace-with-a-random-secret

# Required by the existing Slack helper. Replace before sending notifications.
SLACK_NOTIFICATION_URL=https://example.com/replace-with-slack-webhook

# Optional AWS bucket configuration; no AWS integration is enabled by default.
AWS_BUCKET=

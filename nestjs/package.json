{
  "name": "boilerplate",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "npm": "please-use-yarn",
    "node": ">=22.23.4",
    "yarn": ">=4.14.1 <5"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "yarn prebuild && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "ts-node": "ts-node -r tsconfig-paths/register -r dotenv/config",
    "ts-node-esm": "node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));'",
    "typeorm": "yarn ts-node-esm ./node_modules/.bin/typeorm -d ./src/config/typeorm.config.ts",
    "typeorm:cli": "yarn ts-node-esm ./node_modules/.bin/typeorm",
    "typeorm:prod": "node ./node_modules/.bin/typeorm -d ./dist/src/config/typeorm.config.js",
    "execute": "node dist/src/execute-script.js",
    "execute:dev": "yarn ts-node-esm src/execute-script.ts",
    "db:create": "tsx create-db.ts",
    "db:create:test": "NODE_ENV=test tsx create-db.ts",
    "db:drop": "tsx drop-db.ts",
    "db:drop:test": "NODE_ENV=test tsx drop-db.ts",
    "db:drop:prod": "node dist/drop-db.js",
    "db:schema:drop": "yarn typeorm schema:drop",
    "db:migrate:create": "yarn typeorm:cli migration:create",
    "db:migrate:generate": "yarn typeorm migration:generate",
    "db:migrate:up": "yarn typeorm migration:run",
    "db:migrate:up:prod": "yarn typeorm:prod migration:run",
    "db:migrate:down": "yarn typeorm migration:revert",
    "db:migrate:down:prod": "yarn typeorm:prod migration:revert",
    "migrate_and_start": "yarn db:create && yarn db:migrate:up && yarn start",
    "migrate_and_start_prod": "node dist/create-db.js && yarn db:migrate:up:prod && yarn start:prod",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^5.0.0",
    "@liaoliaots/nestjs-redis": "^10.0.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@slack/webhook": "^6.1.0",
    "amqplib": "^0.10.3",
    "axios": "^1.1.3",
    "bull": "^4.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "dotenv": "^16.0.3",
    "ioredis": "^5.10.1",
    "multer": "^2.0.0",
    "nest-commander": "3.10.0",
    "pg": "^8.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.2.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/amqplib": "^0.10.0",
    "@types/express": "^5.0.0",
    "@types/inquirer": "^8.1.3",
    "@types/jest": "^29.0.0",
    "@types/jest-when": "^3.5.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.6.5",
    "@types/supertest": "^2.0.12",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "jest-extended": "^4.0.2",
    "jest-when": "^3.5.2",
    "lint-staged": "^16.4.0",
    "nock": "^13.2.9",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.20",
    "supertest": "^7.1.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "4.1.0",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.25.0",
    "webpack": "^5.74.0"
  },
  "peerDependencies": {
    "bull": "^4.10.0"
  },
  "resolutions": {
    "qs": "^6.14.1"
  },
  "packageManager": "yarn@4.14.1"
}
